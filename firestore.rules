rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isConsumerAssigningDriver(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && tripData(tripId).consumerId == request.auth.uid
        && tripData(tripId).status in ['pending', 'scheduled'];
    }

    function isConsumerReleasingDriver(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && tripData(tripId).consumerId == request.auth.uid;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId) || isAdmin() || (
        isSignedIn()
        && request.resource.data.isAvailable == false
        && request.resource.data.currentTrip is string
        && isConsumerAssigningDriver(request.resource.data.currentTrip)
      ) || (
        isSignedIn()
        && request.resource.data.isAvailable == true
        && request.resource.data.currentTrip == null
        && resource.data.currentTrip is string
        && isConsumerReleasingDriver(resource.data.currentTrip)
      );
      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.consumerId == request.auth.uid;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() || isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /fees/{feeId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    match /promo_codes/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /sos_events/{eventId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
